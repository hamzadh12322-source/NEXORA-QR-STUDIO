# Telegram BotFather token. Keep this secret.
BOT_TOKEN=
# Random string, 1-256 chars; Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=replace-with-a-long-random-secret
# Public deployed URL, without trailing slash, e.g. https://your-project.vercel.app
APP_URL=
# Supabase Project URL
SUPABASE_URL=
# Supabase service_role key. Server-side only; NEVER expose in browser or GitHub.
SUPABASE_SERVICE_ROLE_KEY=
